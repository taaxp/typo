<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en-AU</string>
	<key>CFBundleDisplayName</key>
	<string>Typo</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>typo</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Typo uses the microphone only while you dictate, to turn your speech into a text snippet. Audio is processed on this Mac.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Typo transcribes your dictation on this Mac.</string>
	<key>TypoAppGroupID</key>
	<string>$(APP_GROUP_ID)</string>
	<key>TypoCloudKitContainer</key>
	<string>$(ICLOUD_CONTAINER)</string>
	<key>TypoKeychainGroup</key>
	<string>$(AppIdentifierPrefix)com.starconnect.typo.shared</string>
</dict>
</plist>
